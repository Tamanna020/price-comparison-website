# ==============================================================================
# PriceWise AI Beauty - Retailer Integration & Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your authorized API keys and partner feeds.
# Never commit real API secrets, tokens, or private credentials to source control.
#
# When credentials are omitted or left blank, PriceWise AI operates in academic
# DEMO mode: seeded demonstration catalogs are used with clear transparent labels,
# and live API adapters return "unconfigured" / "unavailable" status without crashing.
# ==============================================================================

# Database Configuration
PRICEWISE_DB_PATH=data/pricewise.db

# ------------------------------------------------------------------------------
# Backend API & Server Configuration (Phase 6A)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Phase 6A)
# Official google-genai SDK for semantic SKU extraction and entity parsing.
# NEVER used to predict or fabricate retailer pricing.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 1. NYKAA INTEGRATION (nykaa.com)
# Requires partner affiliate / authorized catalog API access.
# Rate limit: 30 requests/minute.
# ------------------------------------------------------------------------------
NYKAA_API_KEY=
NYKAA_PARTNER_SECRET=

# ------------------------------------------------------------------------------
# 2. TIRA BEAUTY INTEGRATION (tirabeauty.com)
# Reliance Retail Tira partner API or product feed endpoint.
# Rate limit: 30 requests/minute.
# ------------------------------------------------------------------------------
TIRA_PARTNER_TOKEN=
TIRA_API_URL=https://api.tirabeauty.com/v1

# ------------------------------------------------------------------------------
# 3. PURPLLE INTEGRATION (purplle.com)
# Purplle affiliate feed URL and API authentication token.
# Rate limit: 30 requests/minute.
# ------------------------------------------------------------------------------
PURPLLE_FEED_URL=
PURPLLE_API_KEY=

# ------------------------------------------------------------------------------
# 4. AMAZON INDIA PA-API 5.0 (amazon.in)
# Amazon Product Advertising API credentials for India locale.
# Associate Tag is required for compliant affiliate linking.
# Rate limit: 20 requests/minute (1 req/sec standard PA-API limit).
# ------------------------------------------------------------------------------
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=pricewiseai-21

# ------------------------------------------------------------------------------
# 5. MYNTRA INTEGRATION (myntra.com)
# Myntra Beauty partner API credentials.
# Rate limit: 30 requests/minute.
# ------------------------------------------------------------------------------
MYNTRA_PARTNER_KEY=
MYNTRA_AFFILIATE_ID=

